---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { config } from "@/config";
import { getTranslation } from "@/i18n";

const faqs = [1, 2, 3];
---

<Layout
  title="About — sa/acc"
  description="What sa/acc is and how the Saudi Acceleration community works."
>
  <Header />

  <main class="flex-grow z-10 pt-32 pb-24">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-3xl md:text-4xl font-bold mb-2 text-[#e6edf3]">
        <span class="lang-en">{getTranslation("en", "about.title")}</span>
        <span class="lang-ar">{getTranslation("ar", "about.title")}</span>
      </h1>
      <p class="text-[#8b949e] mb-12">
        <span class="lang-en">{getTranslation("en", "about.subtitle")}</span>
        <span class="lang-ar">{getTranslation("ar", "about.subtitle")}</span>
      </p>

      <!-- What is sa/acc -->
      <section class="mb-14">
        <h2 class="text-xl font-bold text-[#e6edf3] mb-3">
          <span class="lang-en">{getTranslation("en", "about.what.title")}</span>
          <span class="lang-ar">{getTranslation("ar", "about.what.title")}</span>
        </h2>
        <p class="text-[#c9d1d9] leading-relaxed">
          <span class="lang-en">{getTranslation("en", "about.what.body")}</span>
          <span class="lang-ar">{getTranslation("ar", "about.what.body")}</span>
        </p>
      </section>

      <!-- FAQ -->
      <section class="mb-14">
        <h2 class="text-xl font-bold text-[#e6edf3] mb-5">
          <span class="lang-en">{getTranslation("en", "about.faq.title")}</span>
          <span class="lang-ar">{getTranslation("ar", "about.faq.title")}</span>
        </h2>
        <div class="flex flex-col gap-4">
          {faqs.map((n) => (
            <div class="border border-[#252525] bg-[#171717] rounded-lg p-6">
              <h3 class="text-base font-bold text-[#e6edf3] mb-2">
                <span class="lang-en">{getTranslation("en", `about.faq.q${n}`)}</span>
                <span class="lang-ar">{getTranslation("ar", `about.faq.q${n}`)}</span>
              </h3>
              <p class="text-sm text-[#8b949e] leading-relaxed">
                <span class="lang-en">{getTranslation("en", `about.faq.a${n}`)}</span>
                <span class="lang-ar">{getTranslation("ar", `about.faq.a${n}`)}</span>
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- Partners & Associations -->
      <section class="grid md:grid-cols-2 gap-8">
        <div class="border border-[#30363d] p-8 bg-[#161b22]/30">
          <h2 class="text-xs font-bold text-[#8b949e] uppercase tracking-widest mb-6 flex items-center gap-2">
            <span class="w-2 h-2 bg-[#3fb950] rounded-full"></span>
            <span class="lang-en">{getTranslation("en", "partners.title")}</span>
            <span class="lang-ar">{getTranslation("ar", "partners.title")}</span>
          </h2>
          {config.partners.map((partner) => (
            <a
              href={partner.url}
              target="_blank"
              rel="noreferrer"
              class="group flex items-center gap-4 p-4 border border-[#30363d] hover:border-[#3fb950] transition-colors [unicode-bidi:isolate]"
              dir="ltr"
            >
              <img src={partner.logo} alt={partner.name} width="40" height="40" class="flex-shrink-0 rounded" />
              <div class="flex-grow">
                <div class="text-base font-bold text-[#e6edf3] group-hover:text-[#3fb950] transition-colors">{partner.name}</div>
                <div class="flex items-center gap-1.5 text-[11px] text-[#8b949e] group-hover:text-[#3fb950] transition-colors" dir="ltr">
                  <span class="[unicode-bidi:isolate]">{partner.urlLabel}</span>
                  <span aria-hidden="true">&rarr;</span>
                </div>
              </div>
            </a>
          ))}
        </div>

        <div class="border border-[#30363d] p-8 bg-[#161b22]/30">
          <h2 class="text-xs font-bold text-[#8b949e] uppercase tracking-widest mb-6 flex items-center gap-2">
            <span class="w-2 h-2 bg-blue-400 rounded-full"></span>
            <span class="lang-en">{getTranslation("en", "associations.title")}</span>
            <span class="lang-ar">{getTranslation("ar", "associations.title")}</span>
          </h2>
          {config.associations.map((assoc) => (
            <a
              href={assoc.url}
              target="_blank"
              rel="noreferrer"
              class="group flex items-center gap-4 p-4 border border-[#30363d] hover:border-[#e6edf3] transition-colors [unicode-bidi:isolate]"
              dir="ltr"
            >
              <img src={assoc.logo} alt={assoc.name} width="40" height="40" class="flex-shrink-0 rounded" />
              <div class="flex-grow">
                <div class="text-base font-bold text-[#e6edf3] transition-colors">{assoc.name}</div>
                <div class="flex items-center gap-1.5 text-[11px] text-[#8b949e] transition-colors" dir="ltr">
                  <span class="[unicode-bidi:isolate]">{assoc.urlLabel}</span>
                  <span aria-hidden="true">&rarr;</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
