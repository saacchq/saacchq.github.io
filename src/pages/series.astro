---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostCard from "@/components/PostCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getReadingTime } from "@/utils/getReadingTime";
import { getAllSeries } from "@/utils/getSeries";
import { getTranslation } from "@/i18n";

const allPosts = getSortedPosts(await getCollection("posts"));
const seriesList = getAllSeries().map((series) => ({
  ...series,
  posts: allPosts.filter((post) =>
    post.data.tags.some((t) => t.toLowerCase() === series.key)
  ),
}));
---

<Layout title="Series — sa/acc" description="Ongoing series from sa/acc, each led by an author.">
  <Header />

  <main class="flex-grow z-10 pt-32 pb-24">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-3xl font-bold mb-2 text-[#e6edf3]">
        <span class="lang-en">{getTranslation("en", "series.title")}</span>
        <span class="lang-ar">{getTranslation("ar", "series.title")}</span>
      </h1>
      <p class="text-[#8b949e] mb-12">
        <span class="lang-en">{getTranslation("en", "series.subtitle")}</span>
        <span class="lang-ar">{getTranslation("ar", "series.subtitle")}</span>
      </p>

      <div class="flex flex-col gap-14">
        {seriesList.map((series) => (
          <section>
            <div class="border-b border-[#252525] pb-4 mb-6">
              <div class="flex items-baseline justify-between gap-3">
                <a href={`/tags/${series.key}`} class="group">
                  <h2 class="text-2xl font-bold text-[#e6edf3] group-hover:text-[#3fb950] transition-colors">
                    <span class="lang-en">{series.name}</span>
                    <span class="lang-ar">{series.nameAr || series.name}</span>
                  </h2>
                </a>
                <span class="text-sm text-[#6E6E6E] whitespace-nowrap">{series.posts.length}</span>
              </div>
              <p class="mt-2 text-sm text-[#8b949e]">
                <a
                  href={series.authorUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-[#3fb950] hover:underline font-bold"
                >
                  {series.author} <span class="font-normal text-[#8b949e]">(@{series.handle})</span>
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
                </a>
              </p>
            </div>

            {series.posts.length === 0 ? (
              <p class="text-[#6E6E6E] text-sm py-4">
                <span class="lang-en">{getTranslation("en", "series.noPostsYet")}</span>
                <span class="lang-ar">{getTranslation("ar", "series.noPostsYet")}</span>
              </p>
            ) : (
              <div class="flex flex-col gap-4">
                {series.posts.map((post) => (
                  <PostCard
                    title={post.data.title}
                    titleAr={post.data.titleAr}
                    description={post.data.description}
                    descriptionAr={post.data.descriptionAr}
                    pubDatetime={post.data.pubDatetime}
                    tags={post.data.tags}
                    readingTime={getReadingTime(post.body ?? "")}
                    slug={post.data.slug ?? post.id}
                  />
                ))}
              </div>
            )}
          </section>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
