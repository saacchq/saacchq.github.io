---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getTranslation } from "@/i18n";
---

<Layout title="404 — sa/acc" description="Page not found.">
  <Header />

  <main class="flex-grow z-10 flex items-center justify-center px-6 py-32">
    <div class="text-center max-w-md">
      <div class="text-6xl md:text-7xl font-black text-[#3fb950] mb-6 font-mono">404</div>
      <h1 class="text-xl md:text-2xl font-bold text-[#e6edf3] mb-3">
        <span class="lang-en">{getTranslation("en", "notFound.title")}</span>
        <span class="lang-ar">{getTranslation("ar", "notFound.title")}</span>
      </h1>
      <p class="text-[#8b949e] mb-8">
        <span class="lang-en">{getTranslation("en", "notFound.body")}</span>
        <span class="lang-ar">{getTranslation("ar", "notFound.body")}</span>
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="inline-flex items-center justify-center px-5 py-2.5 bg-[#3fb950] text-[#0d1117] text-xs font-bold uppercase tracking-widest rounded hover:brightness-110 transition-all"
        >
          <span class="lang-en">{getTranslation("en", "notFound.home")}</span>
          <span class="lang-ar">{getTranslation("ar", "notFound.home")}</span>
        </a>
        <a
          href="/posts"
          class="inline-flex items-center justify-center px-5 py-2.5 border border-[#252525] hover:border-[#3fb950] hover:text-[#3fb950] rounded text-xs font-bold uppercase tracking-widest text-[#8b949e] transition-colors"
        >
          <span class="lang-en">{getTranslation("en", "notFound.posts")}</span>
          <span class="lang-ar">{getTranslation("ar", "notFound.posts")}</span>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
