---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Avatar from "@/components/Avatar.astro";
import PostCard from "@/components/PostCard.astro";
import { getAllMembers, type Member } from "@/utils/getMembers";
import { getReadingTime } from "@/utils/getReadingTime";
import { getTranslation } from "@/i18n";

export async function getStaticPaths() {
  const members = getAllMembers(await getCollection("posts"));
  return members.map((member) => ({
    params: { slug: member.slug },
    props: { member },
  }));
}

interface Props {
  member: Member;
}

const { member } = Astro.props;
const isX = member.url ? /(?:^|\.)x\.com|twitter\.com/.test(member.url) : false;
const isLinkedIn = member.url ? /linkedin\.com/.test(member.url) : false;
---

<Layout
  title={`${member.name} — sa/acc`}
  description={member.bio || `${member.name} — sa/acc community member.`}
  image={member.avatar}
>
  <Header />

  <main class="flex-grow z-10 pt-24 pb-24">
    <div class="max-w-3xl mx-auto px-6">
      <a
        href="/members"
        class="inline-flex items-center gap-1 text-xs text-[#8b949e] hover:text-[#3fb950] transition-colors mb-8"
      >
        <span>&larr;</span>
        <span class="lang-en">{getTranslation("en", "member.back")}</span>
        <span class="lang-ar">{getTranslation("ar", "member.back")}</span>
      </a>

      <!-- Profile header -->
      <header class="flex flex-col sm:flex-row items-start gap-6 mb-12">
        <Avatar name={member.name} avatar={member.avatar} size={128} class="border border-[#252525]" />
        <div class="min-w-0">
          <h1 class="text-3xl md:text-4xl font-bold text-[#e6edf3]">{member.name}</h1>
          {(member.role || member.roleAr) && (
            <p class="mt-1 text-xs font-bold uppercase tracking-widest text-[#3fb950]">
              <span class="lang-en">{member.role}</span>
              <span class="lang-ar">{member.roleAr || member.role}</span>
            </p>
          )}
          {(member.bio || member.bioAr) && (
            <p class="mt-4 text-sm md:text-base text-[#c9d1d9] leading-relaxed max-w-xl">
              <span class="lang-en">{member.bio}</span>
              <span class="lang-ar">{member.bioAr || member.bio}</span>
            </p>
          )}

          <!-- Links -->
          <div class="mt-5 flex flex-wrap items-center gap-3">
            {member.url && (
              <a
                href={member.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-[#252525] hover:border-[#3fb950] hover:text-[#3fb950] rounded text-xs text-[#8b949e] transition-colors"
              >
                {isX && <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>}
                {isLinkedIn && <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>}
                <span>@{member.handle}</span>
              </a>
            )}
            {member.discord && (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-[#252525] rounded text-xs text-[#8b949e]">
                <svg width="14" height="14" viewBox="0 0 71 55" fill="currentColor"><path d="M60.1 4.9A58.5 58.5 0 0 0 45.7.2a.2.2 0 0 0-.2.1 40.8 40.8 0 0 0-1.8 3.7 54 54 0 0 0-16.2 0A37.4 37.4 0 0 0 25.6.3a.2.2 0 0 0-.2-.1A58.4 58.4 0 0 0 11 4.9a.2.2 0 0 0-.1.1C1.6 18.4-.9 31.5.3 44.5a.3.3 0 0 0 .1.2 58.7 58.7 0 0 0 17.7 9 .2.2 0 0 0 .3-.1 42 42 0 0 0 3.6-5.9.2.2 0 0 0-.1-.3 38.7 38.7 0 0 1-5.5-2.6.2.2 0 0 1 0-.4l1.1-.9a.2.2 0 0 1 .2 0 41.9 41.9 0 0 0 35.6 0 .2.2 0 0 1 .2 0l1.1.9a.2.2 0 0 1 0 .4 36.3 36.3 0 0 1-5.5 2.6.2.2 0 0 0-.1.3 47.2 47.2 0 0 0 3.6 5.9.2.2 0 0 0 .3.1 58.5 58.5 0 0 0 17.7-9 .2.2 0 0 0 .1-.2c1.4-15-2.3-28-9.8-39.5a.2.2 0 0 0-.1-.1ZM23.7 36.5c-3.4 0-6.3-3.2-6.3-7s2.8-7 6.3-7c3.5 0 6.4 3.1 6.3 7 0 3.9-2.8 7-6.3 7Zm23.3 0c-3.4 0-6.3-3.2-6.3-7s2.8-7 6.3-7c3.5 0 6.4 3.1 6.3 7 0 3.9-2.8 7-6.3 7Z"/></svg>
                <span>{member.discord}</span>
              </span>
            )}
          </div>
        </div>
      </header>

      <!-- Posts -->
      <h2 class="text-xs font-bold uppercase tracking-widest text-[#6E6E6E] mb-5 border-b border-[#252525] pb-3">
        <span class="lang-en">{getTranslation("en", "member.postsHeading")}</span>
        <span class="lang-ar">{getTranslation("ar", "member.postsHeading")}</span>
        <span class="text-[#3fb950]"> {member.posts.length}</span>
      </h2>

      {member.posts.length === 0 ? (
        <p class="text-[#6E6E6E] text-sm py-4">
          <span class="lang-en">{getTranslation("en", "member.noPosts")}</span>
          <span class="lang-ar">{getTranslation("ar", "member.noPosts")}</span>
        </p>
      ) : (
        <div class="flex flex-col gap-4">
          {member.posts.map((post) => (
            <PostCard
              title={post.data.title}
              titleAr={post.data.titleAr}
              description={post.data.description}
              descriptionAr={post.data.descriptionAr}
              pubDatetime={post.data.pubDatetime}
              tags={post.data.tags}
              readingTime={getReadingTime(post.body ?? "")}
              slug={post.data.slug ?? post.id}
            />
          ))}
        </div>
      )}
    </div>
  </main>

  <Footer />
</Layout>
