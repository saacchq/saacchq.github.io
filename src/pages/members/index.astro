---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Avatar from "@/components/Avatar.astro";
import { getAllMembers } from "@/utils/getMembers";
import { getTranslation } from "@/i18n";

const members = getAllMembers(await getCollection("posts"));

function socialKind(url?: string): "x" | "linkedin" | "link" | null {
  if (!url) return null;
  if (/(?:^|\.)x\.com|twitter\.com/.test(url)) return "x";
  if (/linkedin\.com/.test(url)) return "linkedin";
  return "link";
}
---

<Layout
  title="Members — sa/acc"
  description="The people building sa/acc — the Saudi Acceleration community."
>
  <Header />

  <main class="flex-grow z-10 pt-32 pb-24">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-3xl md:text-4xl font-bold mb-2 text-[#e6edf3]">
        <span class="lang-en">{getTranslation("en", "members.title")}</span>
        <span class="lang-ar">{getTranslation("ar", "members.title")}</span>
      </h1>
      <p class="text-[#8b949e] mb-12">
        <span class="lang-en">{getTranslation("en", "members.subtitle")}</span>
        <span class="lang-ar">{getTranslation("ar", "members.subtitle")}</span>
      </p>

      {members.length === 0 ? (
        <p class="text-[#6E6E6E] text-center py-16">
          <span class="lang-en">{getTranslation("en", "members.noneYet")}</span>
          <span class="lang-ar">{getTranslation("ar", "members.noneYet")}</span>
        </p>
      ) : (
        <div class="flex flex-col gap-4">
          {members.map((m) => {
            const kind = socialKind(m.url);
            return (
              <div class="group flex gap-5 items-start border border-[#252525] bg-[#171717] rounded-lg p-6 transition-colors hover:border-[#3fb950]/50">
                <a href={`/members/${m.slug}`} class="shrink-0" aria-label={m.name}>
                  <Avatar name={m.name} avatar={m.avatar} size={72} />
                </a>
                <div class="min-w-0 flex-grow">
                  <a href={`/members/${m.slug}`} class="inline-block">
                    <h2 class="text-lg font-bold text-[#e6edf3] transition-colors group-hover:text-[#3fb950]">
                      {m.name}
                    </h2>
                  </a>
                  {(m.role || m.roleAr) && (
                    <p class="mt-0.5 text-[10px] font-bold uppercase tracking-widest text-[#3fb950]">
                      <span class="lang-en">{m.role}</span>
                      <span class="lang-ar">{m.roleAr || m.role}</span>
                    </p>
                  )}
                  {(m.bio || m.bioAr) && (
                    <p class="mt-2 line-clamp-2 text-sm text-[#8b949e]">
                      <span class="lang-en">{m.bio}</span>
                      <span class="lang-ar">{m.bioAr || m.bio}</span>
                    </p>
                  )}
                  <div class="mt-3 flex items-center gap-4 text-xs text-[#6E6E6E]">
                    <span>
                      {m.posts.length}{" "}
                      <span class="lang-en">{getTranslation("en", "members.posts")}</span>
                      <span class="lang-ar">{getTranslation("ar", "members.posts")}</span>
                    </span>
                    {m.url && (
                      <a
                        href={m.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 hover:text-[#3fb950] transition-colors"
                        aria-label={kind === "x" ? "X" : kind === "linkedin" ? "LinkedIn" : "Profile"}
                      >
                        {kind === "x" && (
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        )}
                        {kind === "linkedin" && (
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
                        )}
                        {kind === "link" && (
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                        )}
                        <span>@{m.handle}</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </main>

  <Footer />
</Layout>
