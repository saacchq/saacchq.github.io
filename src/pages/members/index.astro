---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Avatar from "@/components/Avatar.astro";
import { config } from "@/config";
import { getAllMembers } from "@/utils/getMembers";
import { getTranslation } from "@/i18n";
import discordMembers from "@/data/discord-members.json";

const featured = getAllMembers();
const featuredDiscordNames = new Set(featured.map((m) => m.discord?.toLowerCase()).filter(Boolean));
const roster = (discordMembers as { id: string; name: string; username: string; avatar: string | null }[])
  .filter((m) => !featuredDiscordNames.has(m.username.toLowerCase()));
---

<Layout title="Members — sa/acc" description="The people in the Saudi Acceleration community.">
  <Header />
  <main class="flex-grow z-10 pt-32 pb-24">
    <div class="max-w-5xl mx-auto px-6">
      <div class="mb-12">
        <p class="eyebrow mb-3">SA/ACC / COMMUNITY</p>
        <h1 class="text-4xl md:text-6xl font-black tracking-tight text-white mb-3">
          <span class="lang-en">{getTranslation("en", "members.title")}</span>
          <span class="lang-ar">{getTranslation("ar", "members.title")}</span>
        </h1>
        <p class="text-white/70 max-w-2xl">
          <span class="lang-en">{getTranslation("en", "members.subtitle")}</span>
          <span class="lang-ar">{getTranslation("ar", "members.subtitle")}</span>
        </p>
      </div>

      <section class="mb-14" aria-labelledby="featured-heading">
        <h2 id="featured-heading" class="text-xs font-bold uppercase tracking-[0.2em] text-white mb-5 border-b border-white/20 pb-3">
          <span class="lang-en">Community profiles</span><span class="lang-ar">ملفات المجتمع</span>
        </h2>
        <div class="grid md:grid-cols-2 gap-4">
          {featured.map((m) => (
            <a href={`/members/${m.slug}`} class="member-card flex items-center gap-4 p-5 border border-white/20 hover:border-[#22A95A] transition-colors">
              <Avatar name={m.name} avatar={m.avatar} size={64} />
              <div class="min-w-0">
                <h3 class="font-bold text-white text-lg">{m.name}</h3>
                {(m.role || m.roleAr) && <p class="text-sm text-white/65"><span class="lang-en">{m.role}</span><span class="lang-ar">{m.roleAr || m.role}</span></p>}
                {m.discord && <p class="text-xs text-white mt-1">@{m.discord}</p>}
              </div>
            </a>
          ))}
        </div>
      </section>

      <section aria-labelledby="discord-heading">
        <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-white/20 pb-3 mb-6">
          <h2 id="discord-heading" class="text-xs font-bold uppercase tracking-[0.2em] text-white">
            <span class="lang-en">Discord members</span><span class="lang-ar">أعضاء ديسكورد</span>
          </h2>
          <a href={config.social.discord} target="_blank" rel="noopener noreferrer" class="text-xs text-white hover:underline">
            <span class="lang-en">Join the server ↗</span><span class="lang-ar">انضم إلى الخادم ↗</span>
          </a>
        </div>
        {roster.length ? (
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
            {roster.map((m) => (
              <div class="member-card flex items-center gap-3 min-w-0 p-3 border border-white/15">
                {m.avatar ? <img src={m.avatar} alt="" width="40" height="40" loading="lazy" class="w-10 h-10 object-cover rounded-full bg-white/10" /> : <div aria-hidden="true" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-white font-bold shrink-0">{m.name.slice(0, 1).toUpperCase()}</div>}
                <div class="min-w-0">
                  <p class="text-sm text-white font-semibold truncate">{m.name}</p>
                  <p class="text-xs text-white/55 truncate">@{m.username}</p>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-sm text-white/65 max-w-2xl">
            <span class="lang-en">The full member directory will appear here once the Discord bot connection is enabled. Join the server to meet the community now.</span>
            <span class="lang-ar">ستظهر قائمة الأعضاء الكاملة هنا بعد تفعيل ربط بوت ديسكورد. يمكنك الانضمام إلى الخادم للتعرف على المجتمع الآن.</span>
          </p>
        )}
      </section>
    </div>
  </main>
  <Footer />
</Layout>
