---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { config } from "@/config";
import { getTranslation } from "@/i18n";

---

<Layout
  title="Join & Contribute — sa/acc"
  description="Join the sa/acc Discord, come to a weekly meeting, or watch live streams and videos on YouTube."
>
  <Header />

  <main class="flex-grow z-10 pt-32 pb-24">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-3xl md:text-4xl font-bold mb-2 text-[#ffffff]">
        <span class="lang-en">{getTranslation("en", "contribute.title")}</span>
        <span class="lang-ar">{getTranslation("ar", "contribute.title")}</span>
      </h1>
      <p class="text-white/70 mb-12">
        <span class="lang-en">{getTranslation("en", "contribute.subtitle")}</span>
        <span class="lang-ar">{getTranslation("ar", "contribute.subtitle")}</span>
      </p>

      <div class="flex flex-col gap-6">
        {/* Discord */}
        <section class="border border-[#333333] bg-[#050505] rounded-lg p-6">
          <h2 class="text-lg font-bold text-[#ffffff] mb-2">
            <span class="lang-en">{getTranslation("en", "contribute.discord.title")}</span>
            <span class="lang-ar">{getTranslation("ar", "contribute.discord.title")}</span>
          </h2>
          <p class="text-sm text-white/70 mb-4">
            <span class="lang-en">{getTranslation("en", "contribute.discord.body")}</span>
            <span class="lang-ar">{getTranslation("ar", "contribute.discord.body")}</span>
          </p>
          <a
            href={config.social.discord}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 bg-[#22A95A] text-[#000000] text-xs font-bold uppercase tracking-widest rounded hover:brightness-110 transition-all"
          >
            <span class="lang-en">{getTranslation("en", "contribute.discord.cta")}</span>
            <span class="lang-ar">{getTranslation("ar", "contribute.discord.cta")}</span>
          </a>
        </section>

        {/* Meeting */}
        <section class="border border-[#333333] bg-[#050505] rounded-lg p-6">
          <h2 class="text-lg font-bold text-[#ffffff] mb-2">
            <span class="lang-en">{getTranslation("en", "contribute.meeting.title")}</span>
            <span class="lang-ar">{getTranslation("ar", "contribute.meeting.title")}</span>
          </h2>
          <p class="text-sm text-white/70 mb-3">
            <span class="lang-en">{getTranslation("en", "contribute.meeting.body")}</span>
            <span class="lang-ar">{getTranslation("ar", "contribute.meeting.body")}</span>
          </p>
          <p class="text-xs text-white font-bold uppercase tracking-widest mb-4">
            <span class="lang-en">{config.meeting.schedule}</span>
            <span class="lang-ar">{config.meeting.scheduleAr}</span>
          </p>
          <a
            href="/saacchq-meeting.ics"
            download="saacchq-meeting.ics"
            class="inline-flex items-center gap-2 px-4 py-2 border border-[#333333] hover:border-[#22A95A] hover:text-white rounded text-xs font-bold uppercase tracking-widest text-white/70 transition-colors"
          >
            <span class="lang-en">{getTranslation("en", "contribute.meeting.cta")}</span>
            <span class="lang-ar">{getTranslation("ar", "contribute.meeting.cta")}</span>
          </a>
        </section>

        {/* YouTube */}
        <section class="border border-[#333333] bg-[#050505] rounded-lg p-6">
          <h2 class="text-lg font-bold text-[#ffffff] mb-2">
            <span class="lang-en">{getTranslation("en", "contribute.youtube.title")}</span>
            <span class="lang-ar">{getTranslation("ar", "contribute.youtube.title")}</span>
          </h2>
          <p class="text-sm text-white/70 mb-4 i18n-body">
            <span class="lang-en">{getTranslation("en", "contribute.youtube.body")}</span>
            <span class="lang-ar">{getTranslation("ar", "contribute.youtube.body")}</span>
          </p>
          <a
            href={config.social.youtube}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 border border-[#22A95A] text-[#22A95A] hover:bg-[#22A95A] hover:text-black rounded text-xs font-bold uppercase tracking-widest transition-colors"
          >
            <span class="lang-en">{getTranslation("en", "contribute.youtube.cta")}</span>
            <span class="lang-ar">{getTranslation("ar", "contribute.youtube.cta")}</span>
            <span aria-hidden="true">↗</span>
          </a>
        </section>

      </div>
    </div>
  </main>

  <Footer />
</Layout>
